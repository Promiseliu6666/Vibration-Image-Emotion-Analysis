\n## 安装下载\n\n> tnpm i --save @antv/util\n\n```js\n// 所有的 api 是都这么引入，名字不同而已\nimport { vec2, vec3 } from '@antv/matrix-util';\n\nvec2.angle(v1, v2);\n```\n\n\n## API 文档\n\n> 推荐使用的 API 文档如下：\n* vec2 新增了以下方法：\n    + angle(v1, v2)\n    + direction(v1, v2)\n    + angleTo(v1, v2)\n    + vertical(out, in) 求垂直向量\n* vec3 未新增方法\n* mat3 新增：\n    + translate(out, m, v)\n    + rotate(out, m, rad)\n    + scale(out, m, v)\n* transform(m, [])\n```js\ntransform(m, [\n    ['t', 100, 200],\n    ['r', 40],\n    ['s', 2, 2]\n]);\n```\n\n\n","time":{"created":"2022-01-27T14:43:10.490Z","modified":"2025-12-10T11:53:56.297Z","3.1.0-beta.3":"2021-10-14T12:15:02.768Z","3.0.4":"2020-12-21T08:17:08.598Z","3.1.0-beta.2":"2020-05-12T05:46:01.332Z","3.1.0-beta.1":"2020-05-10T02:34:33.722Z","3.0.4-beta.7":"2020-05-09T08:42:18.772Z","3.0.4-beta.6":"2020-05-09T08:01:32.940Z","3.0.4-beta.5":"2020-05-09T07:48:09.047Z","3.0.4-beta.4":"2020-05-09T07:42:34.072Z","3.0.4-beta.3":"2020-05-09T07:33:54.745Z","3.0.4-beta.2":"2020-05-09T07:26:58.523Z","3.0.4-beta.1":"2020-05-07T06:50:05.211Z","3.0.3":"2020-05-07T02:26:13.159Z","3.0.2":"2020-04-24T09:23:45.223Z","3.0.1-beta.3":"2020-04-24T08:35:32.502Z","3.0.1-beta.2":"2020-04-24T06:33:22.297Z","3.0.1-beta.1":"2020-04-24T06:21:41.303Z","3.0.0":"2020-04-24T05:51:16.590Z","2.0.7":"2020-04-16T07:18:12.130Z","2.0.6":"2020-04-16T05:52:38.711Z","2.0.6-beta.4":"2020-04-16T01:54:57.173Z","2.0.6-beta.3":"2020-04-15T11:15:46.986Z","2.0.6-beta.2":"2020-04-15T09:00:37.936Z","2.0.6-beta.1":"2020-04-15T07:27:18.704Z","2.0.5":"2020-03-11T12:01:42.965Z","2.0.4":"2019-10-12T03:37:52.865Z","2.0.4-beta.1":"2019-10-12T03:26:04.705Z","2.0.3":"2019-10-12T03:12:22.531Z","2.0.2":"2019-08-20T09:15:26.609Z","2.0.1-beta.1":"2019-06-06T06:01:06.343Z","2.0.0":"2019-04-09T09:28:23.479Z"},"versions":{"3.1.0-beta.3":{"name":"@antv/matrix-util","version":"3.1.0-beta.3","description":"A common util collection for antv projects","main":"lib/index.js","types":"lib/index.d.ts","module":"esm/index.js