# RabbitMQ connection shared by all boxes in the same deployment
RABBITMQ_HOST=192.168.31.249
RABBITMQ_PORT=5672
RABBITMQ_USER=binhua_box
RABBITMQ_PASSWORD=change_me
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=xuzhou

# Per-box identity: each physical box must use a unique serial/name
BOX_SERIAL=0004
BOX_NAME=box_0004

# Address that the backend can use to reach this box local API
BOX_PUBLIC_HOST=192.168.31.66
BOX_PUBLIC_PORT=9100

# Local API bind address on the box
LOCAL_API_HOST=0.0.0.0
LOCAL_API_PORT=9100
