# Sanitized template. Copy to .env.dev and fill private values locally.
# Generate a unique JWT_SECRET_KEY; never commit credentials.
APP_ENV=dev
APP_NAME=智能视频分析平台
APP_ROOT_PATH=/dev-api
APP_HOST=127.0.0.1
APP_PORT=9099
APP_VERSION=1.0.0
APP_RELOAD=true
APP_IP_LOCATION_QUERY=false
APP_SAME_TIME_LOGIN=true
APP_LOG_LEVEL=INFO
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_REDIS_EXPIRE_MINUTES=30
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=ruoyi-fastapi
DB_ECHO=false
DB_MAX_OVERFLOW=10
DB_POOL_SIZE=50
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=2
SRS_HOST=127.0.0.1
SRS_RTMP=1935
SRS_FLV=8080
SRS_API=1985
SRS_FLV_URL=127.0.0.1:8080
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=
RABBITMQ_ROUTINGKEY=
RABBITMQ_QUEUE=
RABBITMQ_QUEUE_PREFIX=ruoyi_
MAIL_ENABLED=false
MAIL_SERVER=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=振动分析系统
MAIL_STARTTLS=false
MAIL_SSL_TLS=true
MAIL_USE_CREDENTIALS=true
MAIL_VALIDATE_CERTS=true
RECIPIENT_EMAIL=
DASHSCOPE_API_KEY=
